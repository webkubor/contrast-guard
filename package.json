    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node src/cli.js"
  },
  "keywords": [
    "wcag",
    "contrast",
    "accessibility",
    "a11y",
    "oklch",
    "color",
    "design-tokens",
    "ci",
    "theme",
    "design-system",
    "visual-regression",
    "computed-style",
    "design-review",
    "ui-audit"
  ],
  "license": "MIT",
